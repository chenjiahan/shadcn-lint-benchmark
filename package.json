{
  "name": "shadcn-lint-benchmark",
  "version": "1.0.0",
  "description": "23 matched TypeScript-aware rules, optionally plus 6 shadcn rules; Oxlint + oxlint-tsgolint, Rslint, ESLint",
  "main": "index.js",
  "scripts": {
    "validate": "node canary.mjs && node bench.mjs --probe && python3 validate.py",
    "bench": "node bench.mjs --measure && python3 summarize.py",
