    "report": "python3 report.py",
    "build:plugin": "bash build-plugin.sh",
    "verify:inputs": "node verify-inputs.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@eslint/core": "0.17.0",
    "@rslint/core": "0.9.2",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.2.6",
    "eslint": "10.9.1",
    "lucide-react": "1.40.0",
    "oxc-parser": "0.148.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  },
